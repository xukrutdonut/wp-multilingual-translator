# ================= Translation Strategy =================
# Cuota diaria de cadenas a traducir por idioma (evita bloqueos o exceder límites)
DAILY_LIMIT_PER_LANG=1000

# Tamaño de cada lote subido a la base de datos de WordPress
BATCH_SIZE=100

# Pausa en segundos entre cada solicitud individual para cuidar la tasa de peticiones
REQUEST_DELAY=0.25

# Intervalo en horas antes de ejecutar el siguiente ciclo de traducción
CYCLE_INTERVAL_HOURS=24

# Archivo de glosario médico
GLOSSARY_FILE=glossary.json

# ================= DeepL Multi-Key Configuration =================
# Claves de DeepL API (Free o Pro). Puedes poner una o varias separadas por coma.
# Ejemplo: DEEPL_API_KEYS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx,yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy:fx
DEEPL_API_KEYS=

